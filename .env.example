# Copy to `.env` and adjust. Settings read these names case-insensitively.

# Runtime environment: dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO

# Queue backend: auto (ping Redis) | celery | inline
# Docker sets `celery`; local dev/tests use `inline` (no broker needed).
TASK_QUEUE_BACKEND=inline

# Redis broker/result backend (used by Docker Celery mode)
REDIS_URL=redis://localhost:6379/0

# Optional real LLM credentials — leave empty to use the deterministic mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Mock external API base URLs (the bundled mock clients ignore these)
KKB_BASE_URL=http://mock-kkb:8001/api/v1
EDEVLET_BASE_URL=http://mock-edevlet:8002/api/v1

# Artifact directories
REPORT_OUTPUT_DIR=data/reports
RESULT_STORE_DIR=data/results
UPLOAD_DIR=data/uploads
