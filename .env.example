# Copy to `.env` (never commit it). Real environment variables win over the file.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ---- LLM (OpenAI-compatible). Key present -> live, absent -> deterministic demo.
# Aliases (first found wins): LLM_API_KEY, DEEPSEEK_API_KEY, GATEWAY_API_KEY, OPENAI_API_KEY
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MODE=auto
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
# Optional Anthropic provider (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ---- Security
JWT_SECRET=
PII_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
DEMO_USERS_ENABLED=true
DEMO_PASSWORD=
# Logged-out token ids: auto | memory | redis. APP_ENV=prod refuses to start unless this is redis,
# JWT_SECRET is >= 32 characters, both keys are set and SEED_DEMO_USERS is false.
SESSION_REVOCATION_BACKEND=auto

# ---- Persistence / queue (Docker overrides these)
DATABASE_URL=sqlite:///data/anil2.db
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_BACKEND=auto

# ---- Notifications
WEBHOOK_URL=
SMTP_HOST=

# ---- KVKK retention (days) for rejected / cancelled applications
RETENTION_DAYS_REJECTED=180
